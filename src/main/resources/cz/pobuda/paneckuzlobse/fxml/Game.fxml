<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="1000.0" prefWidth="1600.0"
            style="-fx-background-color: #121214;"
            stylesheets="@../css/style.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cz.pobuda.paneckuzlobse.controller.GameController">

    <top>
        <HBox alignment="CENTER_LEFT"
              style="-fx-background-color: #16161a; -fx-border-color: #2a2a30; -fx-border-width: 0 0 1 0;"
              BorderPane.alignment="CENTER">
            <padding>
                <Insets top="15" right="35" bottom="15" left="35"/>
            </padding>
            <children>
                <Button text="Zpět do Menu" onAction="#zpetDoMenu" prefHeight="42.0" prefWidth="145.0"
                        styleClass="btn-red-fantasy" style="-fx-font-size: 14px;" />
            </children>
        </HBox>
    </top>

    <center>
        <StackPane BorderPane.alignment="CENTER">
            <children>

                <HBox fx:id="gameContent" visible="false" alignment="CENTER" spacing="25.0"
                      style="-fx-background-color: #121214;">
                    <padding>
                        <Insets top="8" right="25" bottom="8" left="25"/>
                    </padding>
                    <children>

                        <VBox prefWidth="330.0" maxWidth="330.0" prefHeight="800.0" maxHeight="800.0" spacing="12.0"
                              style="-fx-background-color: #1c1c1e; -fx-background-radius: 8px; -fx-padding: 16px; -fx-border-color: #2c2c2e; -fx-border-width: 1px;">
                            <children>
                                <Label text="AKTIVNÍ HRDINA"
                                       style="-fx-text-fill: #FFD700; -fx-font-size: 16px; -fx-font-weight: bold;" />

                                <VBox alignment="CENTER" spacing="8.0"
                                      style="-fx-background-color: #242426; -fx-background-radius: 6px; -fx-padding: 10px; -fx-border-color: #3a3a3c; -fx-border-width: 1px;">
                                    <children>
                                        <ImageView fx:id="activeHeroCardView" fitHeight="230.0" preserveRatio="true" pickOnBounds="true" />
                                        <Label fx:id="activeHeroAbilityStatus" text="Schopnost: Připravena"
                                               style="-fx-text-fill: #4CD964; -fx-font-size: 12px; -fx-font-weight: bold;" />
                                    </children>
                                </VBox>

                                <Separator style="-fx-opacity: 0.3;" />

                                <Label text="HISTORIE TAHŮ"
                                       style="-fx-text-fill: #FFD700; -fx-font-size: 15px; -fx-font-weight: bold;" />

                                <ScrollPane fx:id="logScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS"
                                            style="-fx-background: #161618; -fx-background-color: #161618; -fx-border-color: #2c2c2e; -fx-border-radius: 6px;">
                                    <content>
                                        <VBox fx:id="gameLogBox" spacing="6.0" style="-fx-padding: 10px; -fx-background-color: #161618;" />
                                    </content>
                                </ScrollPane>
                            </children>
                        </VBox>

                        <StackPane prefHeight="800.0" prefWidth="800.0"
                                   maxWidth="800.0" maxHeight="800.0"
                                   style="-fx-background-color: #1c1c1e; -fx-background-radius: 8px; -fx-border-color: #2c2c2e; -fx-border-width: 1px;">
                            <children>
                                <Pane fx:id="boardContainer" prefWidth="800.0" prefHeight="800.0" />
                            </children>
                        </StackPane>

                        <VBox prefWidth="330.0" maxWidth="330.0" prefHeight="800.0" maxHeight="800.0" spacing="20.0"
                              style="-fx-background-color: #1c1c1e; -fx-background-radius: 8px; -fx-padding: 20px; -fx-border-color: #2c2c2e; -fx-border-width: 1px;">
                            <children>
                                <VBox fx:id="playersContainer" alignment="TOP_LEFT" spacing="15.0" />

                                <Separator style="-fx-opacity: 0.3;" />

                                <VBox alignment="TOP_LEFT" spacing="6.0">
                                    <children>
                                        <Label text="POČET KOL"
                                               style="-fx-text-fill: #FFD700; -fx-font-size: 18px; -fx-font-weight: bold;" />
                                        <Label fx:id="roundLabel" text="1"
                                               style="-fx-text-fill: #FFFFFF; -fx-font-size: 26px; -fx-font-weight: bold;" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                    </children>
                </HBox>

                <StackPane fx:id="selectionContainer">
                    <children>
                        <ImageView fitWidth="1600.0" fitHeight="927.0" preserveRatio="false" pickOnBounds="true">
                            <image>
                                <Image url="@../images/selectionbg.jpg" />
                            </image>
                        </ImageView>

                        <VBox style="-fx-background-color: rgba(18, 18, 20, 0.58);" />

                        <VBox fx:id="modeSelectionBox" alignment="CENTER" spacing="25.0">
                            <children>
                                <Label text="ZVOL REŽIM HRY"
                                       style="-fx-text-fill: #FFD700; -fx-font-size: 32px; -fx-font-weight: bold;" />
                                <HBox alignment="CENTER" spacing="20.0">
                                    <children>
                                        <Button text="1v1" onAction="#zvolitRezim2" prefWidth="220.0" prefHeight="60.0"
                                                styleClass="btn-red-fantasy" style="-fx-font-size: 16px;" />
                                        <Button text="1v1v1" onAction="#zvolitRezim3" prefWidth="220.0" prefHeight="60.0"
                                                styleClass="btn-red-fantasy" style="-fx-font-size: 16px;" />
                                        <Button text="1v1v1v1" onAction="#zvolitRezim4" prefWidth="220.0" prefHeight="60.0"
                                                styleClass="btn-red-fantasy" style="-fx-font-size: 16px;" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox fx:id="heroSelectionBox" alignment="CENTER" spacing="20.0" visible="false">
                            <children>
                                <Label fx:id="selectionTitleLabel" text="Hráč 1: Vyber si svého hrdinu"
                                       style="-fx-text-fill: #FFD700; -fx-font-size: 32px; -fx-font-weight: bold;" />

                                <HBox alignment="CENTER" spacing="20.0">
                                    <children>
                                        <Button fx:id="btnRytir" text="Rytíř" onAction="#zvolitRytire" prefWidth="180.0" prefHeight="60.0"
                                                styleClass="btn-red-fantasy" style="-fx-font-size: 16px;" />
                                        <Button fx:id="btnCarodejnice" text="Čarodějnice" onAction="#zvolitCarodejnici" prefWidth="180.0" prefHeight="60.0"
                                                styleClass="btn-red-fantasy" style="-fx-font-size: 16px;" />
                                        <Button fx:id="btnBandita" text="Bandita" onAction="#zvolitBanditu" prefWidth="180.0" prefHeight="60.0"
                                                styleClass="btn-red-fantasy" style="-fx-font-size: 16px;" />
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER" spacing="20.0">
                                    <children>
                                        <Button fx:id="btnNekromant" text="Nekromant" onAction="#zvolitNekromanta" prefWidth="180.0" prefHeight="60.0"
                                                styleClass="btn-red-fantasy" style="-fx-font-size: 16px;" />
                                        <Button fx:id="btnElfka" text="Elfka" onAction="#zvolitElfku" prefWidth="180.0" prefHeight="60.0"
                                                styleClass="btn-red-fantasy" style="-fx-font-size: 16px;" />
                                        <Button fx:id="btnKralovna" text="Královna" onAction="#zvolitKralovnu" prefWidth="180.0" prefHeight="60.0"
                                                styleClass="btn-red-fantasy" style="-fx-font-size: 16px;" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </StackPane>

                <VBox fx:id="itemSelectionOverlay" alignment="CENTER" spacing="25.0" visible="false"
                      style="-fx-background-color: rgba(18, 18, 20, 0.95);">
                    <children>
                        <Label text="POUŽÍT PŘEDMĚT Z INVENTÁŘE"
                               style="-fx-text-fill: #FFD700; -fx-font-size: 28px; -fx-font-weight: bold;" />
                        <HBox fx:id="itemCardsContainer" alignment="CENTER" spacing="25.0" />
                        <Button text="Zrušit" onAction="#zavritVyberPredmetu" prefWidth="120.0" prefHeight="40.0"
                                styleClass="btn-red-fantasy" style="-fx-font-size: 13px;" />
                    </children>
                </VBox>

            </children>
        </StackPane>
    </center>

    <bottom>
        <VBox fx:id="bottomBar" visible="false" managed="false"
              style="-fx-background-color: #1c1c1e; -fx-border-color: #2c2c2e; -fx-border-width: 1 0 0 0;"
              BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER" style="-fx-padding: 10px 0 0 0;">
                    <children>
                        <Label fx:id="statusLabel" text="Na tahu je Hráč 1"
                               style="-fx-text-fill: #FFD700; -fx-font-size: 16px; -fx-font-weight: bold;" />
                    </children>
                </HBox>

                <GridPane>
                    <padding>
                        <Insets top="10" right="180" bottom="12" left="180"/>
                    </padding>
                    <columnConstraints>
                        <ColumnConstraints percentWidth="28.0" />
                        <ColumnConstraints percentWidth="44.0" />
                        <ColumnConstraints percentWidth="28.0" />
                    </columnConstraints>
                    <children>
                        <HBox alignment="CENTER" GridPane.columnIndex="0">
                            <children>
                                <Button text="Hodit kostkou" onAction="#hoditKostkou" prefWidth="180.0" prefHeight="45.0"
                                        styleClass="btn-red-fantasy" style="-fx-font-size: 13px;" />
                            </children>
                        </HBox>

                        <HBox alignment="CENTER" spacing="12.0" GridPane.columnIndex="1">
                            <children>
                                <StackPane prefHeight="50.0" prefWidth="50.0" style="-fx-background-color: #2c2c2e; -fx-border-color: #FFD700; -fx-border-width: 1px; -fx-border-radius: 4px;">
                                    <children><ImageView fx:id="itemSlot1" fitHeight="36.0" fitWidth="36.0" pickOnBounds="true" preserveRatio="true" /></children>
                                </StackPane>
                                <StackPane prefHeight="50.0" prefWidth="50.0" style="-fx-background-color: #2c2c2e; -fx-border-color: #FFD700; -fx-border-width: 1px; -fx-border-radius: 4px;">
                                    <children><ImageView fx:id="itemSlot2" fitHeight="36.0" fitWidth="36.0" pickOnBounds="true" preserveRatio="true" /></children>
                                </StackPane>
                                <StackPane prefHeight="50.0" prefWidth="50.0" style="-fx-background-color: #2c2c2e; -fx-border-color: #FFD700; -fx-border-width: 1px; -fx-border-radius: 4px;">
                                    <children><ImageView fx:id="itemSlot3" fitHeight="36.0" fitWidth="36.0" pickOnBounds="true" preserveRatio="true" /></children>
                                </StackPane>
                                <Button text="Použít předmět" onAction="#pouzitPredmet" prefHeight="45.0"
                                        styleClass="btn-red-fantasy" style="-fx-font-size: 12px;" />
                            </children>
                        </HBox>

                        <HBox alignment="CENTER" GridPane.columnIndex="2">
                            <children>
                                <Button text="Použít schopnost" onAction="#pouzitSchopnost" prefWidth="180.0" prefHeight="45.0"
                                        styleClass="btn-red-fantasy" style="-fx-font-size: 13px;" />
                            </children>
                        </HBox>
                    </children>
                </GridPane>
            </children>
        </VBox>
    </bottom>
</BorderPane>